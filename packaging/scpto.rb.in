class Scpto < Formula
  desc "Dual-pane terminal file transfer over SFTP"
  homepage "https://github.com/thisishugow/scpto"
  version "@@VERSION@@"
  license "MIT"

  on_macos do
    on_intel do
      url "https://github.com/thisishugow/scpto/releases/download/v@@VERSION@@/scpto-@@VERSION@@-x86_64-apple-darwin.tar.gz"
      sha256 "@@SHA256_X86_64_MACOS@@"
    end
    on_arm do
      url "https://github.com/thisishugow/scpto/releases/download/v@@VERSION@@/scpto-@@VERSION@@-aarch64-apple-darwin.tar.gz"
      sha256 "@@SHA256_AARCH64_MACOS@@"
    end
  end

  on_linux do
    on_intel do
      url "https://github.com/thisishugow/scpto/releases/download/v@@VERSION@@/scpto-@@VERSION@@-x86_64-unknown-linux-musl.tar.gz"
      sha256 "@@SHA256_X86_64_LINUX@@"
    end
    on_arm do
      url "https://github.com/thisishugow/scpto/releases/download/v@@VERSION@@/scpto-@@VERSION@@-aarch64-unknown-linux-musl.tar.gz"
      sha256 "@@SHA256_AARCH64_LINUX@@"
    end
  end

  def install
    bin.install "scpto"
    doc.install "README.md", "README.zh-TW.md", "CHANGELOG.md"
    prefix.install "LICENSE"
  end

  test do
    assert_equal "scpto #{version}\n", shell_output("#{bin}/scpto --version")
    assert_match "SCPTO_CONFIG", shell_output("#{bin}/scpto --help")
  end
end
